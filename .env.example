# =============================================================================
# Mode
# =============================================================================
# true  = single-user local mode (GITHUB_TOKEN, no Auth0)
# false = cloud multi-user mode (Auth0 + MongoDB required)
LOCAL=true

# =============================================================================
# GitHub
# =============================================================================
# Personal access token with `repo` scope — required in local mode
GITHUB_TOKEN=

# =============================================================================
# CLI provider
# =============================================================================
# Which agent runs code changes in each repo: claude (default) or devin
CLI_PROVIDER=claude

# Required when CLI_PROVIDER=claude
ANTHROPIC_API_KEY=

# Optional: override the model used by the Claude CLI
# CLAUDE_CLI_DEFAULT_MODEL=

# Optional: override the model used by the Devin CLI
# DEVIN_MODEL=

# =============================================================================
# Databases (optional — defaults to TinyDB + in-memory cache if not set)
# =============================================================================
MONGODB_URI=mongodb://mongodb:27017
MONGODB_DATABASE=service-catalog
REDIS_URL=redis://redis:6379

# =============================================================================
# MCP server
# =============================================================================
MCP_PORT=8200
LOG_LEVEL=INFO

# =============================================================================
# Observability (optional)
# =============================================================================
# LANGSMITH_API_KEY=
# LANGSMITH_TRACING=true
# LANGSMITH_PROJECT=service-catalog

# =============================================================================
# Cloud mode only (LOCAL=false)
# =============================================================================
# Auth0
# MCP_AUTH0_DOMAIN=
# MCP_AUTH0_CLIENT_ID=
# MCP_AUTH0_CLIENT_SECRET=
# MCP_AUTH0_AUDIENCE=
# MCP_BASE_URL=https://your-mcp-host.example.com

# GitHub App (replaces GITHUB_TOKEN in cloud mode)
# GITHUB_APP_ID=
# GITHUB_APP_NAME=
# GITHUB_PRIVATE_KEY_PATH=/data/service-catalog.pem

# Stripe (optional billing)
# STRIPE_API_KEY=
# STRIPE_WEBHOOK_SECRET=
